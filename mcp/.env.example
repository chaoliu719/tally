# Copy this file to .env and fill in real values, then run:
#   docker compose up -d --build

# Required — static bearer token clients must send as `Authorization: Bearer <token>`.
# Also the login gate for the OAuth /authorize step.
# Generate one with: openssl rand -hex 32
TALLY_MCP_TOKEN=change-me

# Required — secret used to sign/verify confirmation tokens for destructive
# operations (ledger/source/category/transaction delete). Independent of
# TALLY_MCP_TOKEN — use a different value.
# Generate one with: openssl rand -hex 32
TALLY_CONFIRMATION_SECRET=change-me-too

# Required — secret that signs/verifies the OAuth authorization codes, access
# tokens, and client IDs (for adding tally-mcp as a claude.ai custom connector).
# Independent of the two secrets above. Rotating it invalidates every issued
# access token at once.
# Generate one with: openssl rand -hex 32
TALLY_OAUTH_SIGNING_SECRET=change-me-three

# Required — the externally reachable origin of this server, no trailing slash
# (e.g. https://tally.liuchao.life). Anchors the OAuth issuer, the well-known
# metadata URLs, and the canonical resource URI (this value + /mcp) that access
# tokens are bound to. Must match how clients actually reach the server.
TALLY_PUBLIC_BASE_URL=https://tally.example.com

# Optional — host port to publish. The container always listens on 16355
# internally; this only changes which port it's reachable at on this machine.
TALLY_HOST_PORT=16355
